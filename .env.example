# AGENT REPUBLIC v1.1 — configuration TEMPLATE. There is no functional app yet.
# Never put user wallet keys, pairing codes, QR sessions or secrets into git.
NEXT_PUBLIC_CHAIN_ID=56
NEXT_PUBLIC_AGENT_ID_ADDRESS=0x60b9262456de011f7d15a54cdd8c48baaa8b022f
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_CORE_ADDRESS=
BSC_RPC_URL=
# Web server-side API base URL (Next.js server components fetch from here).
API_BASE_URL=http://127.0.0.1:8787
PORT=8787
DATABASE_URL=postgres://postgres@127.0.0.1:5432/agent_republic
# Dedicated database for integration tests; when unset those tests are skipped.
TEST_DATABASE_URL=
REDIS_URL=
LLM_PROVIDER_API_KEY=
LLM_MODEL=
# Optional local Ollama model for personal commands. Leave empty for the rules engine.
COMMAND_LOCAL_MODEL=
COMMAND_MODEL_DAILY_CALLS=30
CONFIRMATIONS_REQUIRED=12
AGENT_DAILY_COST_LIMIT_USD=5
DELEGATE_NOTE_ENABLED=false
# World engine: tick is off-chain visualization only, not an on-chain epoch.
WORLD_SCENE_VERSION=district-01@1
WORLD_SEED=
WORLD_TICK_SECONDS=60
WORLD_AGENT_VISIBLE_LIMIT=30
WORLD_SSE_ENABLED=true
WORLD_STALE_BLOCK_THRESHOLD=50
# Browser: if WebGL unsupported, accessible HTML panels are mandatory.
NEXT_PUBLIC_WORLD_3D_ENABLED=true
SESSION_SECRET=
# DEV ONLY: fixed app_user UUID for local UI previews. Forbidden in production.
DEV_SESSION_APP_USER_ID=

# Optional, isolated desktop guest pilot. These are runtime-only server variables.
# Configure all three in a private environment file and leave the local café DB unset.
NEXCIV_GUEST_ORIGIN=
NEXCIV_GUEST_DB=
NEXCIV_GUEST_SECRET=
NEXCIV_GUEST_PORT=3000
